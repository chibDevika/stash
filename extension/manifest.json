{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.0.0",
  "description": "Save any article or YouTube video to your personal knowledge base with one click.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "options_page": "options.html",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.railway.app/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.vercel.app/*", "http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Stash",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
