# ─────────────────────────────────────────────────────────────────────────────
# Stash — environment variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# For local dev: Docker Compose defaults work out of the box.
# For production: set these as Railway / Vercel / hosting env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Your Gemini API key — get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_key_here

# ── Database ─────────────────────────────────────────────────────────────────

# Local Docker Compose default — works out of the box
DATABASE_URL=postgresql://stash:stash@db:5432/stash

# Production (Neon): replace with your Neon connection string
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/stash?sslmode=require

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app,chrome-extension://your-extension-id
ALLOWED_ORIGINS=http://localhost:3000

# ── Environment ──────────────────────────────────────────────────────────────

ENVIRONMENT=development
# Production: ENVIRONMENT=production

# ── Frontend (Vercel build env var) ──────────────────────────────────────────

# Set this in Vercel to point at your Railway backend
# VITE_BACKEND_URL=https://your-app.up.railway.app

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# All three values are in: Project Settings → API

# Your Supabase project URL (e.g. https://xyzabc.supabase.co)
SUPABASE_URL=

# JWT Secret — Settings → API → JWT Settings → JWT Secret
# If left empty, auth is disabled (convenient for local dev without login)
SUPABASE_JWT_SECRET=

# Service Role Key — Settings → API → Project API keys → service_role
# Never expose this to the browser — backend only
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode — pre-seeded read-only items, no auth required (always enabled)
DEMO_MODE_ENABLED=true

# ── Optional: port overrides (local Docker only) ──────────────────────────────

# BACKEND_PORT=8000
# FRONTEND_PORT=3000
