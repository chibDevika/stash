# Webapp environment variables — copy to .env and fill in your values
#
#   cp webapp/.env.example webapp/.env
#
# These are Vite public vars (safe to expose to the browser — use anon key only).

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe for browser)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Backend URL — only needed in production (Vercel) to point at your Railway backend
# VITE_BACKEND_URL=https://your-app.up.railway.app
